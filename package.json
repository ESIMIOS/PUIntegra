{
  "name": "puintegra",
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "dev:web": "pnpm run seed:emulators && pnpm --filter @puintegra/web dev",
    "dev:emulators": "firebase emulators:start",
    "seed:emulators": "pnpm --filter @puintegra/api seed:emulators"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "farmhash",
      "protobufjs",
      "vue-demi",
      "@firebase/util",
      "firebase-tools",
      "re2"
    ],
    "overrides": {
      "protobufjs": "7.5.5",
      "basic-ftp": "5.3.0",
      "hono": "4.12.15",
      "vite": "6.4.2",
      "esbuild": "0.25.0",
      "@tootallnate/once": "3.0.1"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devDependencies": {
    "firebase-tools": "15.23.0"
  }
}
