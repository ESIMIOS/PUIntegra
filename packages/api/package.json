{
  "name": "@puintegra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm --filter @puintegra/shared build && tsc",
    "typecheck": "pnpm --filter @puintegra/shared build && tsc --noEmit",
    "test": "pnpm --filter @puintegra/shared build && vitest run --exclude tests/firestore.rules.test.ts",
    "test:coverage": "pnpm --filter @puintegra/shared build && vitest run --coverage --exclude tests/firestore.rules.test.ts",
    "lint": "eslint src/**/*.ts",
    "dev": "firebase emulators:start --only functions",
    "seed:emulators": "pnpm run build && node dist/emulator/seedEmulators.js",
    "test:firestore-rules": "firebase emulators:exec --config ../../firebase.json --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "bootstrap:system-admin": "pnpm run build && node dist/ops/bootstrapSystemAdmin.js"
  },
  "dependencies": {
    "@puintegra/shared": "workspace:*",
    "firebase-admin": "12.7.0",
    "firebase-functions": "7.2.5",
    "hono": "4.12.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "25.9.2",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "9.39.4",
    "firebase": "12.12.1",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  }
}
