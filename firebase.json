{
  "firestore": {
    "rules": "firebase/firestore/firestore.rules",
    "indexes": "firebase/firestore/firestore.indexes.json"
  },
  "functions": {
    "source": "packages/api",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "packages/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "storage": {
    "rules": "firebase/storage/storage.rules"
  },
  "emulators": {
    "auth":      { "host":"127.0.0.1","port": 9099 },
    "functions": { "host":"127.0.0.1","port": 5001 },
    "firestore": { "host":"127.0.0.1","port": 8081 },
    "hosting":   { "host":"127.0.0.1","port": 5002 },
    "storage":   { "host":"127.0.0.1","port": 9199 },
    "ui":        { "enabled": true, "port": 4000 }
  }
}
